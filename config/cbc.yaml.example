# VectorCore CBC configuration. The upstream CBE delivers CAP 1.2 alerts
# using XEP-0127 (CAP over XMPP).
server:
  listen_address: "127.0.0.1:8087"
  shutdown_timeout: "10s"
database:
  path: "data/cbc.db"
  busy_timeout: "5s"
  expiry_interval: "1m"
cbs:
  # Message Identifiers for standard CMAS/WEA categories (Presidential,
  # Extreme/Severe threat by urgency+certainty, AMBER, Required Monthly
  # Test, CMAS Exercise, and the WEA 3.0 additions Public Safety/
  # State-Local-Test) are hardcoded per 3GPP TS 23.041 section 9.4.1.2.2 -
  # they're fixed by the standard, not chosen per operator, so nothing needs
  # setting here for those. default_message_identifier is used only when an
  # alert doesn't match any CMAS category (e.g. a routine advisory).
  default_message_identifier: 0x1112
  # message_identifiers is a rare manual override, keyed by classification
  # label (not raw CAP severity) - e.g. to override a hardcoded value for a
  # deployment that needs something nonstandard:
  #   public-safety: 0x112C
  message_identifiers: {}
  # Safety default: alerts without a recognised cell/TA geocode are rejected.
  allow_plmn_wide: false
sbcap:
  # Enable only after MME peer addresses and area targeting are approved.
  # Per TS 29.168 the CBC establishes and maintains this SCTP association at
  # all times (not just when there's an alert to send) - an eNB restart
  # indication arriving while disconnected would otherwise be lost.
  enabled: false
  plmn: "001-01"
  repetition_period: 30
  broadcasts: 4
  response_timeout: "10s"
  reconnect_min: "1s"
  reconnect_max: "30s"
  # Pin the outbound association to a single local IP. Leave empty unless
  # the MME authorizes CBC peers by a single source IP - the OS otherwise
  # multi-homes across every local interface, which MMEs with a single-IP
  # allowlist will reject.
  local_address: ""
  peers:
    - name: "mme-1"
      address: "192.0.2.10:29168"
cell_inventory:
  # LTE cell/TAC/eNB/MME inventory import, export, and selection preview.
  # Shares this file's database.path; there is no separate database.
  enabled: false
  max_import_size_bytes: 10485760
  default_import_mode: "validate-only"
logging:
  level: "info"
cbe:
  address: "cbe.example.com:5222"
  domain: "cbe.example.com"
  username: "cbc"
  password: "replace-with-a-secret-from-your-deployment-system"
  resource: "vectorcore-cbc"
  # plain: STARTTLS upgrade on port 5222; direct_tls: TLS from connection start.
  tls_mode: "plain"
  # Set true only for development with a CBE test certificate.
  insecure_skip_verify: false
  reconnect_min: "1s"
  reconnect_max: "30s"
